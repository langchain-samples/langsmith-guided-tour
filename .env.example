# --- LangSmith: this workspace (tracing, datasets, rules, deploys) ---
LANGSMITH_API_KEY="<langsmith-api-key>"
LANGSMITH_TRACING="true"
# Needed when your key spans several workspaces: Settings -> General.
# LANGSMITH_WORKSPACE_ID="<workspace-id>"
# EU / APAC / AWS regions: https://eu.api.smith.langchain.com, https://apac.api.smith.langchain.com, https://aws.api.smith.langchain.com
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# --- Where traces go ---
# utils/config.py traces to client-research-agent / development unless you set these.
# LANGSMITH_AGENT_ID="client-research-agent"
# LANGSMITH_AGENT_ENVIRONMENT="development"
# Self-hosted or project-based workspaces: set a project instead. Never set both.
# LANGSMITH_PROJECT="langsmith-poc"

# --- LLM Gateway: every model call (utils/models.py) ---
# A key with gateway:invoke from a workspace that has model access; it can be the same as LANGSMITH_API_KEY.
LANGSMITH_GATEWAY_API_KEY="<langsmith-gateway-api-key>"
# Module 6 turns on gateway routing for Anthropic models with one variable.
# LANGSMITH_GATEWAY="true"

# --- Web search for the agent ---
TAVILY_API_KEY="<tavily-api-key>"

# --- Direct providers: only for the matching commented pair in utils/models.py ---
# ANTHROPIC_API_KEY="<anthropic-api-key>"
# OPENAI_API_KEY="<openai-api-key>"
# AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
# AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION_NAME=""
